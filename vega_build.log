              '\n'
              'def macroop IRET_REAL {\n'
              '    .serialize_after\n'
              '\n'
              '    # temp_RIP\n'
              '    ld t1, ss, [1, t0, rsp], "0 * env.dataSize", '
              'addressSize=ssz\n'
              '    # temp_CS\n'
              '    ld t2, ss, [1, t0, rsp], "1 * env.dataSize", '
              'addressSize=ssz\n'
              '    # temp_RFLAGS\n'
              '    ld t3, ss, [1, t0, rsp], "2 * env.dataSize", '
              'addressSize=ssz\n'
              '\n'
              '    # Update RSP now that all memory accesses have succeeded.\n'
              '    addi rsp, rsp, "3 * env.dataSize", dataSize=ssz\n'
              '\n'
              '    # Update CS.\n'
              '    wrsel cs, t2\n'
              "    # Make sure there isn't any junk in the upper bits of the "
              'base.\n'
              '    mov t4, t0, t2\n'
              '    slli t4, t4, 4, dataSize=8\n'
              '    wrbase cs, t4, dataSize=8\n'
              '\n'
              '    # Update RFLAGS\n'
              '    # Get the current RFLAGS\n'
              '    rflags t4, dataSize=8\n'
              '    # Flip flag bits if they should change.\n'
              '    mov t5, t4, t3\n'
              '    xor t5, t5, t4, dataSize=8\n'
              "    # Don't change VIF, VIP, or VM\n"
              '    limm t6, "~(VIFBit | VIPBit | VMBit)", dataSize=8\n'
              '    and t5, t5, t6, dataSize=8\n'
              '    # Write back RFLAGS with flipped bits.\n'
              '    wrflags t4, t5, dataSize=8\n'
              '\n'
              '    # Update RIP\n'
              '    wrip t1, t0\n'
              '};\n'
              '\n'
              'def macroop IRET_PROT {\n'
              '    .serialize_after\n'
              '    .adjust_env oszIn64Override\n'
              '\n'
              "    # Check for a nested task. This isn't supported at the "
              'moment.\n'
              '    rflag t1, 14; #NT bit\n'
              '    panic "Task switching with iret is unimplemented!", '
              'flags=(nCEZF,)\n'
              '\n'
              '    #t1 = temp_RIP\n'
              '    #t2 = temp_CS\n'
              '    #t3 = temp_RFLAGS\n'
              '    #t4 = handy m5 register\n'
              '\n'
              '    # Pop temp_RIP, temp_CS, and temp_RFLAGS\n'
              '    ld t1, ss, [1, t0, rsp], "0 * env.dataSize", '
              'addressSize=ssz\n'
              '    ld t2, ss, [1, t0, rsp], "1 * env.dataSize", '
              'addressSize=ssz\n'
              '    ld t3, ss, [1, t0, rsp], "2 * env.dataSize", '
              'addressSize=ssz\n'
              '\n'
              '    # Read the handy m5 register for use later\n'
              '    rdm5reg t4\n'
              '\n'
              '\n'
              '###\n'
              "### Handle if we're returning to virtual 8086 mode.\n"
              '###\n'
              '\n'
              '    #IF ((temp_RFLAGS.VM=1) && (CPL=0) && (LEGACY_MODE))\n'
              '    #    IRET_FROM_PROTECTED_TO_VIRTUAL\n'
              '\n'
              '    #temp_RFLAGS.VM != 1\n'
              '    rcri t0, t3, 18, flags=(ECF,)\n'
              '    br label("protToVirtFallThrough"), flags=(nCECF,)\n'
              '\n'
              '    #CPL=0\n'
              '    andi t0, t4, 0x30, flags=(EZF,)\n'
              '    br label("protToVirtFallThrough"), flags=(nCEZF,)\n'
              '\n'
              '    #(LEGACY_MODE)\n'
              '    rcri t0, t4, 1, flags=(ECF,)\n'
              '    br label("protToVirtFallThrough"), flags=(nCECF,)\n'
              '\n'
              '    panic "iret to virtual mode not supported"\n'
              '\n'
              'protToVirtFallThrough:\n'
              '\n'
              '\n'
              '\n'
              '    #temp_CPL = temp_CS.rpl\n'
              '    andi t5, t2, 0x3\n'
              '\n'
              '\n'
              '###\n'
              '### Read in the info for the new CS segment.\n'
              '###\n'
              '\n'
              '    #CS = READ_DESCRIPTOR (temp_CS, iret_chk)\n'
              '    andi t0, t2, 0xFC, flags=(EZF,), dataSize=2\n'
              '    br label("processCSDescriptor"), flags=(CEZF,)\n'
              '    andi t6, t2, 0xF8, dataSize=8\n'
              '    andi t0, t2, 0x4, flags=(EZF,), dataSize=2\n'
              '    br label("globalCSDescriptor"), flags=(CEZF,)\n'
              '    ld t8, tsl, [1, t0, t6], dataSize=8, addressSize=8, '
              'atCPL0=True\n'
              '    br label("processCSDescriptor")\n'
              'globalCSDescriptor:\n'
              '    ld t8, tsg, [1, t0, t6], dataSize=8, addressSize=8, '
              'atCPL0=True\n'
              'processCSDescriptor:\n'
              '    chks t2, t6, dataSize=8\n'
              '\n'
              '\n'
              '###\n'
              '### Get the new stack pointer and stack segment off the old '
              'stack if necessary,\n'
              '### and piggyback on the logic to check the new RIP value.\n'
              '###\n'
              '    #IF ((64BIT_MODE) || (temp_CPL!=CPL))\n'
              '    #{\n'
              '\n'
              '    #(64BIT_MODE)\n'
              '    andi t0, t4, 0xE, flags=(EZF,)\n'
              "    # Since we just found out we're in 64 bit mode, take "
              'advantage and\n'
              '    # do the appropriate RIP checks.\n'
              '    br label("doPopStackStuffAndCheckRIP"), flags=(CEZF,)\n'
              '\n'
              "    # Here, we know we're -not- in 64 bit mode, so we should do "
              'the\n'
              '    # appropriate/other RIP checks.\n'
              '    # if temp_RIP > CS.limit throw #GP(0)\n'
              '    rdlimit t6, cs, dataSize=8\n'
              '    sub t0, t6, t1, flags=(ECF,)\n'
              '    fault "std::make_shared<GeneralProtection>(0)", '
              'flags=(CECF,)\n'
              '\n'
              '    #(temp_CPL!=CPL)\n'
              '    srli t7, t4, 4\n'
              '    xor t7, t7, t5\n'
              '    andi t0, t7, 0x3, flags=(EZF,)\n'
              '    br label("doPopStackStuff"), flags=(nCEZF,)\n'
              "    # We can modify user visible state here because we're know\n"
              "    # we're done with things that can fault.\n"
              '    addi rsp, rsp, "3 * env.dataSize", dataSize=ssz\n'
              '    br label("fallThroughPopStackStuff")\n'
              '\n'
              'doPopStackStuffAndCheckRIP:\n'
              '    # Check if the RIP is canonical.\n'
              '    srai t7, t1, 47, flags=(EZF,), dataSize=8\n'
              "    # if t7 isn't 0 or -1, it wasn't canonical.\n"
              '    br label("doPopStackStuff"), flags=(CEZF,)\n'
              '    addi t0, t7, 1, flags=(EZF,), dataSize=8\n'
              '    fault "std::make_shared<GeneralProtection>(0)", '
              'flags=(nCEZF,)\n'
              '\n'
              'doPopStackStuff:\n'
              '    #    POP.v temp_RSP\n'
              '    ld t6, ss, [1, t0, rsp], "3 * env.dataSize", '
              'addressSize=ssz\n'
              '    #    POP.v temp_SS\n'
              '    ld t9, ss, [1, t0, rsp], "4 * env.dataSize", '
              'addressSize=ssz\n'
              '    #    SS = READ_DESCRIPTOR (temp_SS, ss_chk)\n'
              '    andi t0, t9, 0xFC, flags=(EZF,), dataSize=2\n'
              '    br label("processSSDescriptor"), flags=(CEZF,)\n'
              '    andi t7, t9, 0xF8, dataSize=8\n'
              '    andi t0, t9, 0x4, flags=(EZF,), dataSize=2\n'
              '    br label("globalSSDescriptor"), flags=(CEZF,)\n'
              '    ld t7, tsl, [1, t0, t7], dataSize=8, addressSize=8, '
              'atCPL0=True\n'
              '    br label("processSSDescriptor")\n'
              'globalSSDescriptor:\n'
              '    ld t7, tsg, [1, t0, t7], dataSize=8, addressSize=8, '
              'atCPL0=True\n'
              'processSSDescriptor:\n'
              '    chks t9, t7, dataSize=8\n'
              '\n'
              '    # This actually updates state which is wrong. It should '
              'wait until we know\n'
              "    # we're not going to fault. Unfortunately, that's hard to "
              'do.\n'
              '    wrdl ss, t7, t9\n'
              '    wrsel ss, t9\n'
              '\n'
              '###\n'
              "### From this point downwards, we can't fault. We can update "
              'user visible state.\n'
              '###\n'
              '    #    RSP.s = temp_RSP\n'
              '    mov rsp, rsp, t6, dataSize=ssz\n'
              '\n'
              '    #}\n'
              '\n'
              'fallThroughPopStackStuff:\n'
              '\n'
              '    # Update CS\n'
              '    wrdl cs, t8, t2\n'
              '    wrsel cs, t2\n'
              '\n'
              '    #CPL = temp_CPL\n'
              '\n'
              '    #IF (changing CPL)\n'
              '    #{\n'
              '    srli t7, t4, 4\n'
              '    xor t7, t7, t5\n'
              '    andi t0, t7, 0x3, flags=(EZF,)\n'
              '    br label("skipSegmentSquashing"), flags=(CEZF,)\n'
              '\n'
              '    # The attribute register needs to keep track of more info '
              'before this will\n'
              '    # work the way it needs to.\n'
              '    #    FOR (seg = ES, DS, FS, GS)\n'
              '    #        IF ((seg.attr.dpl < cpl && ((seg.attr.type = '
              "'data')\n"
              "    #            || (seg.attr.type = 'non-conforming-code')))\n"
              '    #        {\n'
              '    #            seg = NULL\n'
              '    #        }\n'
              '    #}\n'
              '\n'
              'skipSegmentSquashing:\n'
              '\n'
              '    # Ignore this for now.\n'
              '    #RFLAGS.v = temp_RFLAGS\n'
              '    wrflags t0, t3\n'
              '    #  VIF,VIP,IOPL only changed if (old_CPL = 0)\n'
              '    #  IF only changed if (old_CPL <= old_RFLAGS.IOPL)\n'
              '    #  VM unchanged\n'
              '    #  RF cleared\n'
              '\n'
              '    #RIP = temp_RIP\n'
              '    wrip t0, t1\n'
              '};\n'
              '\n'
              'def macroop IRET_VIRT {\n'
              '    panic "Virtual mode iret isn\'t implemented!"\n'
              '};\n'
              '\n'
              'def macroop INT3 {\n'
              '\n'
              '    limm t1, 0x03, dataSize=8\n'
              '\n'
              '    rdip t7\n'
              '\n'
              '    # Are we in long mode?\n'
              '    rdm5reg t5\n'
              '    andi t0, t5, 0x1, flags=(EZF,)\n'
              '    br rom_label("longModeSoftInterrupt"), flags=(CEZF,)\n'
              '    br rom_label("legacyModeInterrupt")\n'
              '};\n'
              '\n'
              'def macroop INT3_VIRT {\n'
              '    panic "Virtual mode int3 isn\'t implemented!"\n'
              '};\n'
              '\n'
              'def macroop INT3_REAL {\n'
              '    panic "Real mode int3 isn\'t implemented!"\n'
              '};\n'
              '\n'
              'def macroop INT_LONG_I {\n'
              '    #load the byte-sized interrupt vector specified in the '
              'instruction\n'
              '    .adjust_imm trimImm(8)\n'
              '    limm t1, imm, dataSize=8\n'
              '\n'
              '    rdip t7\n'
              '\n'
              '    # Are we in long mode?\n'
              '    br rom_label("longModeSoftInterrupt")\n'
              '};\n'
              '\n'
              'def macroop INT_PROT_I {\n'
              '    #load the byte-sized interrupt vector specified in the '
              'instruction\n'
              '    .adjust_imm trimImm(8)\n'
              '    limm t1, imm, dataSize=8\n'
              '\n'
              '    rdip t7\n'
              '\n'
              '    # Are we in long mode?\n'
              '    br rom_label("legacyModeInterrupt")\n'
              '};\n'
              '\n'
              'def macroop INT_REAL_I {\n'
              '    #load the byte-sized interrupt vector specified in the '
              'instruction\n'
              '    .adjust_imm trimImm(8)\n'
              '    limm t1, imm, dataSize=8\n'
              '\n'
              '    # temp_RIP\n'
              '    ld t2, idtr, [4, t1, t0], dataSize=2, addressSize=8\n'
              '    # temp_CS\n'
              '    ld t3, idtr, [4, t1, t0], 2, dataSize=2, addressSize=8\n'
              '\n'
              '    cda ss, [1, t0, rsp], -2, dataSize=2, addressSize=ssz\n'
              '    cda ss, [1, t0, rsp], -6, dataSize=2, addressSize=ssz\n'
              '\n'
              '    rflags t4, dataSize=8\n'
              '    rdsel t5, cs, dataSize=8\n'
              '    rdip t6\n'
              '\n'
              '    # Push RFLAGS.\n'
