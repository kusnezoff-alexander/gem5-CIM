              '\n'
              'longModeInterrupt_cplStackSwitch:\n'
              '    # Get the new rsp from the TSS\n'
              '    ld t6, tr, [8, t10, t0], 4, dataSize=8, addressSize=8, '
              'atCPL0=True\n'
