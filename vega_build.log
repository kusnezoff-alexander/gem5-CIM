              '    st rsp, hs, [1, t0, t6], 24 + 0, dataSize=8, addressSize=8\n'
              '    rdsel t5, ss, dataSize=2\n'
              '    st t5, hs, [1, t0, t6], 32 + 0, dataSize=8, addressSize=8\n'
              '\n'
