 'microcode': '\n'
              '# X86 microcode\n'
              '\n'
              'def rom\n'
              '{\n'
              '    # This vectors the CPU into an interrupt handler in long '
              'mode.\n'
              '    # On entry, t1 is set to the vector of the interrupt and t7 '
              'is the current\n'
              '    # ip. We need that because rdip returns the next ip.\n'
              '    extern longModeInterrupt:\n'
              '\n'
              '    #\n'
              '    # Get the 64 bit interrupt or trap gate descriptor from the '
              'IDT\n'
              '    #\n'
              '\n'
              '    # Load the gate descriptor from the IDT\n'
              '    slli t4, t1, 4, dataSize=8\n'
              '    ld t2, idtr, [1, t0, t4], 8, dataSize=8, addressSize=8, '
              'atCPL0=True\n'
              '    ld t4, idtr, [1, t0, t4], dataSize=8, addressSize=8, '
              'atCPL0=True\n'
              '\n'
              '    # Make sure the descriptor is a legal gate.\n'
              '    chks t1, t4, IntGateCheck\n'
              '\n'
              '    #\n'
              '    # Get the target CS descriptor using the selector in the '
              'gate\n'
              '    # descriptor.\n'
              '    #\n'
              '    srli t10, t4, 16, dataSize=8\n'
              '    andi t5, t10, 0xF8, dataSize=8\n'
              '    andi t0, t10, 0x4, flags=(EZF,), dataSize=2\n'
              '    br rom_local_label("longModeInterrupt_globalDescriptor"), '
              'flags=(CEZF,)\n'
              '    ld t3, tsl, [1, t0, t5], dataSize=8, addressSize=8, '
              'atCPL0=True\n'
              '    br rom_local_label("longModeInterrupt_processDescriptor")\n'
              'longModeInterrupt_globalDescriptor:\n'
              '    ld t3, tsg, [1, t0, t5], dataSize=8, addressSize=8, '
              'atCPL0=True\n'
              'longModeInterrupt_processDescriptor:\n'
              '    chks t10, t3, IntCSCheck, dataSize=8\n'
              '    wrdl hs, t3, t10, dataSize=8\n'
              '\n'
              '    # Stick the target offset in t9.\n'
              '    wrdh t9, t4, t2, dataSize=8\n'
              '\n'
              '\n'
              '    #\n'
              '    # Figure out where the stack should be\n'
              '    #\n'
              '\n'
              '    # Record what we might set the stack selector to.\n'
              '    rdsel t11, ss\n'
              '\n'
              "    # Check if we're changing privelege level. At this point we "
              'can assume\n'
              "    # we're going to a DPL that's less than or equal to the "
              'CPL.\n'
              '    rdattr t10, hs, dataSize=8\n'
              '    andi t10, t10, 3, dataSize=8\n'
              '    rdattr t5, cs, dataSize=8\n'
              '    andi t5, t5, 0x3, dataSize=8\n'
              '    sub t0, t5, t10, flags=(EZF,), dataSize=8\n'
              "    # We're going to change priviledge, so zero out the stack "
              'selector. We\n'
              "    # need to let the IST have priority so we don't branch "
              'yet.\n'
              '    mov t11, t0, t0, flags=(nCEZF,)\n'
              '\n'
              '    # Check the IST field of the gate descriptor\n'
              '    srli t12, t4, 32, dataSize=8\n'
              '    andi t12, t12, 0x7, dataSize=8\n'
              '    subi t0, t12, 1, flags=(ECF,), dataSize=8\n'
