              '};\n'
              '\n'
              'def macroop INT_REAL_I {\n'
              '    #load the byte-sized interrupt vector specified in the '
              'instruction\n'
              '    .adjust_imm trimImm(8)\n'
              '    limm t1, imm, dataSize=8\n'
              '\n'
              '    # temp_RIP\n'
              '    ld t2, idtr, [4, t1, t0], dataSize=2, addressSize=8\n'
              '    # temp_CS\n'
              '    ld t3, idtr, [4, t1, t0], 2, dataSize=2, addressSize=8\n'
              '\n'
              '    cda ss, [1, t0, rsp], -2, dataSize=2, addressSize=ssz\n'
              '    cda ss, [1, t0, rsp], -6, dataSize=2, addressSize=ssz\n'
              '\n'
              '    rflags t4, dataSize=8\n'
              '    rdsel t5, cs, dataSize=8\n'
              '    rdip t6\n'
              '\n'
              '    # Push RFLAGS.\n'
              '    st t4, ss, [1, t0, rsp], -2, dataSize=2, addressSize=ssz\n'
              '    # Push CS.\n'
              '    st t5, ss, [1, t0, rsp], -4, dataSize=2, addressSize=ssz\n'
              '    # Push the next RIP.\n'
              '    st t6, ss, [1, t0, rsp], -6, dataSize=2, addressSize=ssz\n'
              '\n'
              '    # Update RSP\n'
              '    subi rsp, rsp, 6, dataSize=ssz\n'
              '\n'
              '    # Set the CS selector.\n'
              '    wrsel cs, t3, dataSize=2\n'
              "    # Make sure there isn't any junk in the upper bits of the "
              'base.\n'
              '    mov t3, t0, t3\n'
              '    # Compute and set CS base.\n'
              '    slli t3, t3, 4, dataSize=8\n'
              '    wrbase cs, t3, dataSize=8\n'
              '\n'
              '    # If AC, TF, IF or RF are set, we want to flip them.\n'
              '    limm t7, "(ACBit | TFBit | IFBit | RFBit)", dataSize=8\n'
              '    and t7, t4, t7, dataSize=8\n'
              '    wrflags t4, t7, dataSize=8\n'
              '\n'
              '    # Set the new RIP\n'
              '    wrip t2, t0\n'
              '};\n'
              '\n'
