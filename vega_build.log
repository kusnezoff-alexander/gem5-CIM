              '};\n'
              '\n'
              'def macroop CALL_NEAR_P\n'
              '{\n'
              '    # Make the default data size of calls 64 bits in 64 bit '
              'mode\n'
              '    .adjust_env oszIn64Override\n'
              '    .function_call\n'
              '    .control_indirect\n'
              '\n'
              '    rdip t7\n'
              '    ld t1, seg, riprel, disp\n'
              '    # Check target of call\n'
              '    st t7, ss, [0, t0, rsp], "-env.dataSize", addressSize=ssz\n'
              '    subi rsp, rsp, dsz, dataSize=ssz\n'
              '    wripi t1, 0\n'
              '};\n'
              '\n'
              'def macroop CALL_FAR_REAL_I {\n'
              '    .function_call\n'
              '    .control_indirect\n'
              '\n'
              '    limm t1, imm, dataSize=8\n'
              '\n'
              '    # Multiply the data size by 8 to get the size of the offset '
              'in bits.\n'
              '    limm t3, dsz, dataSize=8\n'
              '    slli t3, t3, 3, dataSize=8\n'
              '\n'
              '    # Extract the selector from the far pointer.\n'
              '    srl t2, t1, t3, dataSize=8\n'
              '    zexti t2, t2, 15, dataSize=8\n'
              '    # Extract the offset from the far pointer.\n'
              '    zext t1, t1, t3, dataSize=8\n'
              '\n'
              '    # Compute the base.\n'
              '    slli t3, t2, 4, dataSize=8\n'
              '\n'
              '    # Make sure pushing the RIP will work after we push cs.\n'
              '    cda ss, [1, t0, rsp], "-env.dataSize * 2", addressSize=ssz\n'
              '\n'
              '    # Push CS.\n'
              '    rdsel t4, cs, dataSize=8\n'
              '    st t4, ss, [1, t0, rsp], "-env.dataSize", addressSize=ssz\n'
              '    # Push RIP.\n'
              '    rdip t7\n'
              '    st t7, ss, [1, t0, rsp], "-env.dataSize * 2", '
              'addressSize=ssz\n'
              '    subi rsp, rsp, "env.dataSize * 2", dataSize=ssz\n'
              '\n'
              '    # Install the new selector, base and RIP values.\n'
              '    wrsel cs, t2, dataSize=2\n'
              '    wrbase cs, t3, dataSize=8\n'
              '    wrip t1, t0\n'
              '};\n'
              '\n'
              'def macroop CALL_FAR_REAL_M {\n'
              '    .function_call\n'
              '    .control_indirect\n'
              '\n'
              '    lea t1, seg, sib, disp, dataSize=asz\n'
              '    # Load the selector.\n'
              '    ld t2, seg, [1, t0, t1], dsz, dataSize=2\n'
              '    # Load the offset.\n'
              '    ld t1, seg, [1, t0, t1]\n'
              '\n'
              '    # Compute the base.\n'
              '    zexti t3, t2, 15, dataSize=8\n'
              '    slli t3, t3, 4, dataSize=8\n'
              '\n'
              '    # Make sure pushing the RIP will work after we push cs.\n'
              '    cda ss, [1, t0, rsp], "-env.dataSize * 2", addressSize=ssz\n'
              '\n'
              '    # Push CS.\n'
              '    rdsel t4, cs, dataSize=8\n'
              '    st t4, ss, [1, t0, rsp], "-env.dataSize", addressSize=ssz\n'
              '    # Push RIP.\n'
              '    rdip t7\n'
              '    st t7, ss, [1, t0, rsp], "-env.dataSize * 2", '
              'addressSize=ssz\n'
              '    subi rsp, rsp, "env.dataSize * 2", dataSize=ssz\n'
              '\n'
              '    # Install the new selector, base and RIP values.\n'
              '    wrsel cs, t2, dataSize=2\n'
              '    wrbase cs, t3, dataSize=8\n'
              '    wrip t1, t0\n'
              '};\n'
              '\n'
