              '    # t1 has the offset and t2 has the new selector.\n'
              '    # This is intended to run in protected mode.\n'
              '    andi t0, t2, 0xFC, flags=(EZF,), dataSize=2\n'
              '    fault "std::make_shared<GeneralProtection>(0)", '
              'flags=(CEZF,)\n'
              '    andi t3, t2, 0xF8, dataSize=8\n'
              '    andi t0, t2, 0x4, flags=(EZF,), dataSize=2\n'
              '    br rom_local_label("farJmpGlobalDescriptor"), '
