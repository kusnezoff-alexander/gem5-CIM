              'longModeInterruptWithError_stackSwitched:\n'
              '\n'
              '    andi t6, t6, 0xF0, dataSize=1\n'
              '    subi t6, t6, 40 + 8, dataSize=8\n'
              '\n'
              '    ##\n'
              '    ## Point of no return.\n'
              "    ## We're now going to irrevocably modify visible state.\n"
              "    ## Anything bad that's going to happen should have happened "
              'by now or will\n'
              '    ## happen right now.\n'
              '    ##\n'
              '    wrip t0, t9, dataSize=8\n'
              '\n'
              '    #\n'
              '    # Set up the target code segment. Do this now so we have '
              'the right\n'
              '    # permissions when setting up the stack frame.\n'
              '    #\n'
              '    srli t5, t4, 16, dataSize=8\n'
              '    andi t5, t5, 0xFF, dataSize=8\n'
              '    wrdl cs, t3, t5, dataSize=8\n'
              '    # Tuck away the old CS for use below\n'
              '    limm t10, 0, dataSize=8\n'
              '    rdsel t10, cs, dataSize=2\n'
              '    wrsel cs, t5, dataSize=2\n'
              '\n'
              '    # Check that we can access everything we need to on the '
              'stack\n'
              '    ldst t0, hs, [1, t0, t6], dataSize=8, addressSize=8\n'
              '    ldst t0, hs, [1, t0, t6],          32 + 8, dataSize=8, '
              'addressSize=8\n'
              '\n'
              '\n'
              '    #\n'
              '    # Build up the interrupt stack frame\n'
              '    #\n'
              '\n'
              '\n'
              '    # Write out the contents of memory\n'
              '    \n'
              '    st t15, hs, [1, t0, t6], dataSize=8, addressSize=8\n'
              '    \n'
              '    st t7, hs, [1, t0, t6], 8, dataSize=8, addressSize=8\n'
              '    st t10, hs, [1, t0, t6], 8 + 8, dataSize=8, addressSize=8\n'
              '    rflags t10, dataSize=8\n'
              '    st t10, hs, [1, t0, t6], 16 + 8, dataSize=8, addressSize=8\n'
              '    st rsp, hs, [1, t0, t6], 24 + 8, dataSize=8, addressSize=8\n'
              '    rdsel t5, ss, dataSize=2\n'
              '    st t5, hs, [1, t0, t6], 32 + 8, dataSize=8, addressSize=8\n'
              '\n'
              '    # Set the stack segment\n'
              '    mov rsp, rsp, t6, dataSize=8\n'
              '    wrsel ss, t11, dataSize=2\n'
              '\n'
              '    #\n'
              '    # Adjust rflags which is still in t10 from above\n'
              '    #\n'
              '\n'
              '    # Set IF to the lowest bit of the original gate type.\n'
              '    # The type field of the original gate starts at bit 40.\n'
              '\n'
              "    # Set the TF, NT, and RF bits. We'll flip them at the end.\n"
              '    limm t6, (1 << 8) | (1 << 14) | (1 << 16), dataSize=8\n'
              '    or t10, t10, t6, dataSize=8\n'
              '    srli t5, t4, 40, dataSize=8\n'
              '    srli t7, t10, 9, dataSize=8\n'
              '    xor t5, t7, t5, dataSize=8\n'
              '    andi t5, t5, 1, dataSize=8\n'
              '    slli t5, t5, 9, dataSize=8\n'
              '    or t6, t5, t6, dataSize=8\n'
              '\n'
              '    # Put the results into rflags\n'
              '    wrflags t6, t10\n'
              '\n'
              '    eret\n'
              '};\n'
              '\n'
              'def rom\n'
              '{\n'
              '    # This vectors the CPU into an interrupt handler in legacy '
              'mode.\n'
              '    extern legacyModeInterrupt:\n'
              '    panic "Legacy mode interrupts not implemented (in '
              'microcode)"\n'
              '    eret\n'
              '};\n'
              '\n'
              'def rom\n'
              '{\n'
              '    extern initIntHalt:\n'
              '    rflags t1\n'
              '    limm t2, "~IFBit"\n'
              '    and t1, t1, t2\n'
              '    wrflags t1, t0\n'
              '    halt\n'
              '    eret\n'
              '};\n'
              '\n'
              'def rom\n'
              '{\n'
              '    extern realModeInterrupt:\n'
              '\n'
              '    # t1 - The vector.\n'
              '    # t2 - The old CS.\n'
              '    # t7 - The old RIP.\n'
              '    # t3 - RFLAGS\n'
              '    # t4 - The new CS.\n'
              '    # t5 - The new RIP.\n'
              '\n'
              '    rdsel t2, cs, dataSize=8\n'
              '    rflags t3, dataSize=8\n'
              '\n'
              '    ld t4, idtr, [4, t1, t0], 2, dataSize=2, addressSize=2\n'
              '    ld t5, idtr, [4, t1, t0], dataSize=2, addressSize=2\n'
              '\n'
              '    # Make sure pushes after the first will also work.\n'
              '    cda ss, [1, t0, rsp], -4, dataSize=2, addressSize=2\n'
              '    cda ss, [1, t0, rsp], -6, dataSize=2, addressSize=2\n'
              '\n'
              '    # Push the low 16 bits of RFLAGS.\n'
              '    st t3, ss, [1, t0, rsp], -2, dataSize=2, addressSize=2\n'
              '    # Push CS.\n'
              '    st t2, ss, [1, t0, rsp], -4, dataSize=2, addressSize=2\n'
              '    # Push the old RIP.\n'
              '    st t7, ss, [1, t0, rsp], -6, dataSize=2, addressSize=2\n'
              '\n'
              '    # Update RSP.\n'
              '    subi rsp, rsp, 6, dataSize=2\n'
              '\n'
              '    # Set the new CS selector.\n'
              '    wrsel cs, t4, dataSize=2\n'
              "    # Make sure there isn't any junk in the upper bits of the "
              'base.\n'
              '    mov t4, t0, t4, dataSize=2\n'
              '    # Compute and set CS base.\n'
              '    slli t4, t4, 4, dataSize=8\n'
              '    wrbase cs, t4, dataSize=8\n'
              '\n'
              '    # If IF or TF are set, we want to flip them.\n'
              '    limm t6, "(TFBit | IFBit)", dataSize=8\n'
              '    and t6, t6, t3, dataSize=8\n'
              '    wrflags t3, t6, dataSize=8\n'
              '\n'
              '    # Set the new RIP.\n'
              '    wrip t5, t0, dataSize=2\n'
              '\n'
              '    eret\n'
              '};\n'
