              '#\n'
              '# Real mode versions of the load far pointer instructions.\n'
              '#\n'
              '\n'
              'def macroop LDS_REAL_R_M {\n'
              '    # Calculate the address of the pointer.\n'
              '    lea t1, seg, sib, disp, dataSize=asz\n'
              '\n'
              '    # Load the selector into a temporary.\n'
              '    ld t2, seg, [1, t0, t1], dsz, dataSize=2\n'
              '    # Load the offset.\n'
              '    ld reg, seg, [1, t0, t1], 0\n'
              '    # Install the selector value.\n'
              '    wrsel ds, t2\n'
              "    # Make sure there isn't any junk in the upper bits of the "
              'base.\n'
              '    mov t2, t0, t2\n'
              '    # Compute and set the base.\n'
              '    slli t2, t2, 4, dataSize=8\n'
              '    wrbase ds, t2, dataSize=8\n'
              '};\n'
              '\n'
              'def macroop LES_REAL_R_M {\n'
              '    # Calculate the address of the pointer.\n'
              '    lea t1, seg, sib, disp, dataSize=asz\n'
