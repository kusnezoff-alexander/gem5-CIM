              '    ld t2, seg, sib, disp\n'
              '    mul1s t2, t1, flags=(OF,CF)\n'
              '    mulel reg\n'
              '    muleh t0\n'
              '};\n'
              '\n'
              'def macroop IMUL_R_P_I\n'
              '{\n'
              '    rdip t7\n'
              '    limm t1, imm\n'
              '    ld t2, seg, riprel, disp\n'
              '    mul1s t2, t1, flags=(OF,CF)\n'
              '    mulel reg\n'
              '    muleh t0\n'
              '};\n'
              '\n'
              'def macroop DIV_B_R\n'
              '{\n'
              '    \n'
              '    # Do the initial part of the division\n'
              '    div1 ah, reg, dataSize=1\n'
              '\n'
              '    #These are split out so we can initialize the number of '
              'bits in the\n'
              '    #second register\n'
              '    div2i t1, rax, 8, dataSize=1\n'
              '    div2 t1, rax, t1, dataSize=1\n'
              '\n'
              "    #Loop until we're out of bits to shift in\n"
              'divLoopTop:\n'
              '    div2 t1, rax, t1, dataSize=1\n'
              '    div2 t1, rax, t1, flags=(EZF,), dataSize=1\n'
              '    br label("divLoopTop"), flags=(nCEZF,)\n'
              '\n'
              '    #Unload the answer\n'
              '    divq rax, dataSize=1\n'
              '    divr ah, dataSize=1\n'
              '};\n'
              '\n'
              'def macroop DIV_R\n'
              '{\n'
              '    \n'
              '    # Do the initial part of the division\n'
              '    div1 rdx, reg\n'
              '\n'
              '    #These are split out so we can initialize the number of '
              'bits in the\n'
              '    #second register\n'
              '    div2i t1, rax, "env.dataSize * 8"\n'
              '    div2 t1, rax, t1\n'
              '\n'
              "    #Loop until we're out of bits to shift in\n"
              '    #The amount of unrolling here could stand some tuning\n'
              'divLoopTop:\n'
              '    div2 t1, rax, t1\n'
              '    div2 t1, rax, t1\n'
              '    div2 t1, rax, t1\n'
              '    div2 t1, rax, t1, flags=(EZF,)\n'
              '    br label("divLoopTop"), flags=(nCEZF,)\n'
              '\n'
              '    #Unload the answer\n'
              '    divq rax\n'
              '    divr rdx\n'
              '};\n'
              '\n'
              'def macroop IDIV_B_R\n'
              '{\n'
              '    # Negate dividend\n'
              '    sub t1, t0, rax, flags=(ECF,), dataSize=1\n'
              '    ruflag t4, 3\n'
              '    sub t2, t0, ah, dataSize=1\n'
              '    sub t2, t2, t4\n'
              '\n'
              '    \n'
              '\n'
              '    #Find the sign of the divisor\n'
              '    slli t0, reg, 1, flags=(ECF,), dataSize=1\n'
              '\n'
              '    # Negate divisor\n'
              '    sub t3, t0, reg, dataSize=1\n'
              "    # Put the divisor's absolute value into t3\n"
              '    mov t3, t3, reg, flags=(nCECF,), dataSize=1\n'
              '\n'
              '    #Find the sign of the dividend\n'
              '    slli t0, ah, 1, flags=(ECF,), dataSize=1\n'
              '\n'
              "    # Put the dividend's absolute value into t1 and t2\n"
              '    mov t1, t1, rax, flags=(nCECF,), dataSize=1\n'
              '    mov t2, t2, ah, flags=(nCECF,), dataSize=1\n'
              '\n'
              '    # Do the initial part of the division\n'
              '    div1 t2, t3, dataSize=1\n'
              '\n'
              '    #These are split out so we can initialize the number of '
              'bits in the\n'
              '    #second register\n'
              '    div2i t4, t1, 8, dataSize=1\n'
              '    div2 t4, t1, t4, dataSize=1\n'
              '\n'
              "    #Loop until we're out of bits to shift in\n"
              'divLoopTop:\n'
              '    div2 t4, t1, t4, dataSize=1\n'
              '    div2 t4, t1, t4, flags=(EZF,), dataSize=1\n'
              '    br label("divLoopTop"), flags=(nCEZF,)\n'
              '\n'
              '    #Unload the answer\n'
              '    divq t5, dataSize=1\n'
              '    divr t6, dataSize=1\n'
              '\n'
              '    # Fix up signs. The sign of the dividend is still lying '
              'around in ECF.\n'
              '    # The sign of the remainder, ah, is the same as the '
              'dividend. The sign\n'
              '    # of the quotient is negated if the signs of the divisor '
              'and dividend\n'
              '    # were different.\n'
              '\n'
              '    # Negate the remainder\n'
              '    sub t4, t0, t6, dataSize=1\n'
              '    # If the dividend was negitive, put the negated remainder '
              'in ah.\n'
              '    mov ah, ah, t4, (CECF,), dataSize=1\n'
              '    # Otherwise put the regular remainder in ah.\n'
              '    mov ah, ah, t6, (nCECF,), dataSize=1\n'
              '\n'
              '    # Negate the quotient.\n'
              '    sub t4, t0, t5, dataSize=1\n'
              '    # If the dividend was negative, start using the negated '
              'quotient\n'
              '    mov t5, t5, t4, (CECF,), dataSize=1\n'
              '\n'
              '    # Check the sign of the divisor\n'
              '    slli t0, reg, 1, flags=(ECF,), dataSize=1\n'
              '\n'
              '    # Negate the (possibly already negated) quotient\n'
              '    sub t4, t0, t5, dataSize=1\n'
              '    # If the divisor was negative, put the negated quotient in '
              'rax.\n'
              '    mov rax, rax, t4, (CECF,), dataSize=1\n'
              "    # Otherwise put the one that wasn't negated (at least here) "
              'in rax.\n'
              '    mov rax, rax, t5, (nCECF,), dataSize=1\n'
              '};\n'
              '\n'
              'def macroop IDIV_R\n'
              '{\n'
              '    # Negate dividend\n'
              '    sub t1, t0, rax, flags=(ECF,)\n'
              '    ruflag t4, 3\n'
              '    sub t2, t0, rdx\n'
              '    sub t2, t2, t4\n'
              '\n'
              '    \n'
              '\n'
              '    #Find the sign of the divisor\n'
              '    slli t0, reg, 1, flags=(ECF,)\n'
              '\n'
              '    # Negate divisor\n'
              '    sub t3, t0, reg\n'
              "    # Put the divisor's absolute value into t3\n"
              '    mov t3, t3, reg, flags=(nCECF,)\n'
              '\n'
              '    #Find the sign of the dividend\n'
              '    slli t0, rdx, 1, flags=(ECF,)\n'
              '\n'
              "    # Put the dividend's absolute value into t1 and t2\n"
              '    mov t1, t1, rax, flags=(nCECF,)\n'
              '    mov t2, t2, rdx, flags=(nCECF,)\n'
              '\n'
              '    # Do the initial part of the division\n'
              '    div1 t2, t3\n'
              '\n'
              '    #These are split out so we can initialize the number of '
              'bits in the\n'
              '    #second register\n'
              '    div2i t4, t1, "env.dataSize * 8"\n'
              '    div2 t4, t1, t4\n'
              '\n'
              "    #Loop until we're out of bits to shift in\n"
              'divLoopTop:\n'
              '    div2 t4, t1, t4\n'
              '    div2 t4, t1, t4\n'
              '    div2 t4, t1, t4\n'
              '    div2 t4, t1, t4, flags=(EZF,)\n'
              '    br label("divLoopTop"), flags=(nCEZF,)\n'
              '\n'
              '    #Unload the answer\n'
              '    divq t5\n'
              '    divr t6\n'
              '\n'
              '    # Fix up signs. The sign of the dividend is still lying '
              'around in ECF.\n'
