    class SerializeOp(X86Microop):
        def __init__(self):
            self.className = "Serialize"
            self.mnemonic = "serialize"
            self.instFlags = "| (1ULL << StaticInst::IsSerializeAfter)"

        def getAllocator(self, microFlags):
