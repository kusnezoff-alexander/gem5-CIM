              'def macroop SYSCALL_64\n'
              '{\n'
              '    # All 1s.\n'
              '    limm t1, "(uint64_t)(-1)", dataSize=8\n'
              '\n'
              '    # Save the next RIP.\n'
              '    rdip rcx\n'
              '\n'
              '    # Stick rflags with RF masked into r11.\n'
              '    rflags t2\n'
              '    limm t3, "~RFBit", dataSize=8\n'
              '    and r11, t2, t3, dataSize=8\n'
              '\n'
              '    rdval t3, star\n'
              '    srli t3, t3, 32, dataSize=8\n'
              '    andi t3, t3, 0xFC, dataSize=1\n'
              '\n'
              '    # Set up CS.\n'
              '    wrsel cs, t3\n'
              '    wrbase cs, t0, dataSize=8\n'
              '    wrlimit cs, t1, dataSize=4\n'
              '    # Not writable, read/execute-able, not expandDown,\n'
              '    # dpl=0, defaultSize=0, long mode\n'
              '    limm t4, ((0 << 0)  | (0  << 2)  | (0 << 3)   '
              '|               (1 << 4)  | (0  << 5)  | (1 << 6)   '
              '|               (1 << 7)  | (10 << 8)  | (0 << 12)  '
              '|               (1 << 13) | (0  << 14) | (1 << 15)), '
              'dataSize=8\n'
              '    wrattr cs, t4\n'
              '\n'
              '    # Set up SS.\n'
              '    addi t3, t3, 8\n'
              '    wrsel ss, t3\n'
              '    wrbase ss, t0, dataSize=8\n'
              '    wrlimit ss, t1, dataSize=4\n'
              '    # Writable, readable, not expandDown,\n'
              '    # dpl=0, defaultSize=0, not long mode\n'
              '    limm t4, ((0 << 0)  | (0  << 2)  | (1 << 3)   '
              '|               (0 << 4)  | (0  << 5)  | (1 << 6)   '
              '|               (1 << 7)  | (2  << 8)  | (1 << 12)  '
              '|               (1 << 13) | (0  << 14) | (1 << 15)), '
              'dataSize=8\n'
              '    wrattr ss, t4\n'
              '\n'
              '    # Set the new rip.\n'
              '    rdval t7, lstar, dataSize=8\n'
              '    wrip t0, t7, dataSize=8\n'
              '\n'
              '    # Mask the flags against sf_mask and leave RF turned off.\n'
