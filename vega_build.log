                    tmp2h = insertBits(tmp2h, 31, 0, 0);
                }
                if (bits(zmask, 3)) {
                    tmp2h = insertBits(tmp2h, 63, 32, 0);
                }
                FpDestReg_uqw = tmp2h;
            }

