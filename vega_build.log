              '\n'
              'def macroop JMP_FAR_M\n'
              '{\n'
              '    .control_indirect\n'
              '\n'
              '    limm t1, 0, dataSize=8\n'
              '    limm t2, 0, dataSize=8\n'
              '    lea t1, seg, sib, disp, dataSize=asz\n'
