              '    # Load the offset.\n'
              '    ld reg, seg, [1, t0, t1], 0\n'
              '    # Install the selector value.\n'
              '    wrsel gs, t2\n'
              "    # Make sure there isn't any junk in the upper bits of the "
              'base.\n'
              '    mov t2, t0, t2\n'
              '    # Compute and set the base.\n'
              '    slli t2, t2, 4, dataSize=8\n'
              '    wrbase gs, t2, dataSize=8\n'
