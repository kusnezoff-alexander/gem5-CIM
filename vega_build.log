                    break;
                }
                case 1: {
                    tmp2l = insertBits(tmp2l, 63, 32, tmp);
                    break;
                }
                case 2: {
                    tmp2h = insertBits(tmp2h, 31, 0, tmp);
                    break;
                }
                case 3: {
                    tmp2h = insertBits(tmp2h, 63, 32, tmp);
                    break;
                }
            }

            if (!partHi()) {
                if (bits(zmask, 0)) {
                    tmp2l = insertBits(tmp2l, 31, 0, 0);
                }
                if (bits(zmask, 1)) {
                    tmp2l = insertBits(tmp2l, 63, 32, 0);
                }
                FpDestReg_uqw = tmp2l;
            } else {
