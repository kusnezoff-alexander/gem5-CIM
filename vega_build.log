              'def macroop INT3 {\n'
              '\n'
              '    limm t1, 0x03, dataSize=8\n'
              '\n'
              '    rdip t7\n'
              '\n'
              '    # Are we in long mode?\n'
              '    rdm5reg t5\n'
              '    andi t0, t5, 0x1, flags=(EZF,)\n'
              '    br rom_label("longModeSoftInterrupt"), flags=(CEZF,)\n'
              '    br rom_label("legacyModeInterrupt")\n'
              '};\n'
              '\n'
