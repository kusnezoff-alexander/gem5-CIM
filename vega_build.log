              '};\n'
              '\n'
              'def macroop RET_FAR_REAL {\n'
              '    .function_return\n'
              '    .control_indirect\n'
              '\n'
              '    # Pop the return RIP.\n'
              '    ld t1, ss, [1, t0, rsp], addressSize=ssz\n'
              '    # Pop the return CS.\n'
              '    ld t2, ss, [1, t0, rsp], dsz, addressSize=ssz\n'
              '    # Adjust RSP.\n'
              '    addi rsp, rsp, "2 * env.dataSize", dataSize=ssz\n'
              '\n'
              '    # Set the CS selector.\n'
              '    wrsel cs, t2\n'
              "    # Make sure there isn't any junk in the upper bits of the "
              'base.\n'
              '    mov t2, t0, t2\n'
              '    # Compute and set CS base.\n'
              '    slli t2, t2, 4, dataSize=8\n'
              '    wrbase cs, t2, dataSize=8\n'
              '\n'
              '    # Set the new RIP.\n'
              '    wrip t1, t0\n'
              '};\n'
              '\n'
              'def macroop RET_FAR_REAL_I {\n'
              '    .function_return\n'
              '    .control_indirect\n'
              '\n'
              '    # Pop the return RIP.\n'
              '    ld t1, ss, [1, t0, rsp], addressSize=ssz\n'
              '    # Pop the return CS.\n'
              '    ld t2, ss, [1, t0, rsp], dsz, addressSize=ssz\n'
              '    # Adjust RSP.\n'
              '    addi rsp, rsp, "2 * env.dataSize", dataSize=ssz\n'
              '\n'
              '    addi rsp, rsp, imm, dataSize=ssz\n'
              '\n'
              '    # Set the CS selector.\n'
              '    wrsel cs, t2\n'
              "    # Make sure there isn't any junk in the upper bits of the "
              'base.\n'
              '    mov t2, t0, t2\n'
              '    # Compute and set CS base.\n'
              '    slli t2, t2, 4, dataSize=8\n'
              '    wrbase cs, t2, dataSize=8\n'
              '\n'
              '    # Set the new RIP.\n'
              '    wrip t1, t0\n'
              '};\n'
              '\n'
              'def macroop RET_FAR {\n'
              '    .adjust_env oszIn64Override\n'
              '    .function_return\n'
              '    .control_indirect\n'
              '\n'
              '    # Get the return RIP\n'
              '    ld t1, ss, [1, t0, rsp], addressSize=ssz\n'
              '\n'
              '    # Get the return CS\n'
              '    ld t2, ss, [1, t0, rsp], dsz, addressSize=ssz\n'
              '\n'
              '    # increment the stack pointer to pop the instruction '
              'pointer\n'
              '    # and the code segment from the stack.\n'
              '    addi rsp, rsp, dsz, dataSize=ssz\n'
              '    addi rsp, rsp, dsz, dataSize=ssz\n'
              '\n'
              '    # Get the rpl\n'
              '    andi t3, t2, 0x3\n'
              '\n'
              '    # Get the cpl\n'
              '\n'
              "    # Here we'd check if we're changing priviledge levels. "
              "We'll just hope\n"
              "    # that doesn't happen yet.\n"
              '\n'
              "    # Do stuff if they're equal\n"
              '    andi t0, t2, 0xFC, flags=(EZF,), dataSize=2\n'
              '    br label("processDescriptor"), flags=(CEZF,)\n'
              '    andi t3, t2, 0xF8, dataSize=8\n'
              '    andi t0, t2, 0x4, flags=(EZF,), dataSize=2\n'
              '    br label("globalDescriptor"), flags=(CEZF,)\n'
              '    ld t3, tsl, [1, t0, t3], dataSize=8, addressSize=8\n'
              '    br label("processDescriptor")\n'
              'globalDescriptor:\n'
              '    ld t3, tsg, [1, t0, t3], dataSize=8, addressSize=8\n'
              'processDescriptor:\n'
              '    chks t2, t3, IretCheck, dataSize=8\n'
              '    # There should be validity checks on the RIP checks here, '
              "but I'll do\n"
              '    # that later.\n'
              '    wrdl cs, t3, t2\n'
              '    wrsel cs, t2\n'
              '    wrip t0, t1\n'
              '#    br label("end")\n'
              '\n'
              "    # Do other stuff if they're not.\n"
              '#end:\n'
              '#    fault "NoFault"\n'
              '};\n'
              '\n'
              'def macroop BSWAP_D_R\n'
              '{\n'
              '    roli reg, reg, 8, dataSize=2\n'
              '    roli reg, reg, 16, dataSize=4\n'
              '    roli reg, reg, 8, dataSize=2\n'
              '};\n'
              '\n'
              'def macroop BSWAP_Q_R\n'
              '{\n'
              '    roli reg, reg, 8, dataSize=2\n'
              '    roli t1, reg, 16, dataSize=4\n'
              '    # Top 4 bytes of t1 are now zero\n'
              '    roli t1, t1, 8, dataSize=2\n'
              '    roli t1, t1, 32, dataSize=8\n'
              '    srli t2, reg, 32, dataSize=8\n'
              '    roli t2, t2, 8, dataSize=2\n'
              '    roli t2, t2, 16, dataSize=4\n'
              '    # Top 4 bytes of t2 are now zero\n'
              '    roli t2, t2, 8, dataSize=2\n'
              '    or reg, t1, t2, dataSize=8\n'
              '};\n'
              '\n'
              'def macroop CDQE_R {\n'
              '    sexti reg, reg, "env.dataSize * 4 - 1"\n'
              '};\n'
              '\n'
              'def macroop CQO_R_R {\n'
              '    # A shift might be slower than, for example, an explicit '
              'sign extension,\n'
              '    # so it might be worthwhile to try to find an alternative.\n'
              '    mov regm, regm, reg\n'
              '    srai regm, regm, "env.dataSize * 8 - 1"\n'
              '};\n'
              '\n'
