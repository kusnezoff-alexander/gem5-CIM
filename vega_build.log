              'atCPL0=True\n'
              '    br rom_local_label("farJmpProcessDescriptor")\n'
              'farJmpGlobalDescriptor:\n'
              '    ld t4, tsg, [1, t0, t3], dataSize=8, addressSize=8, '
              'atCPL0=True\n'
