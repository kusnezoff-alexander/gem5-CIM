def template RowOpDeclare {{
    class %(class_name)s : public %(base_class)s
    {

    private:
        %(reg_idx_arr_decl)s;

    public:
        // TODO: Constructor
        %(class_name)s(ExtMachInst _machInst);

        Fault execute(ExecContext *, trace::InstRecord *) const override;
        Fault initiateAcc(ExecContext *, trace::InstRecord *)
                const override;
        Fault completeAcc(Packet *, ExecContext *,
                          trace::InstRecord *) const override;

        std::string
        generateDisassembly(Addr pc,
                            const loader::SymbolTable *symtab) const override;
    };
}};

def template RowOpConstructor {{
    %(class_name)s::%(class_name)s(ExtMachInst _machInst) :
        %(base_class)s("%(mnemonic)s", _machInst, %(op_class)s)
    {
		%(set_reg_idx_arr)s;
        %(constructor)s
    }
}};

def template RowOpDecoder {{
    std::string
    %(class_name)s::generateDisassembly(
            Addr pc, const loader::SymbolTable *symtab) const
    {
        return csprintf("%(mnemonic)s: (unimplemented: %(op)s) 2025-11-03");
    }
}};

// NOTE: `%(classname)s` is filled in with `ROWAND`/`ROWOR`/...
def template RowOpExecute {{
    Fault %(class_name)s::execute(ExecContext * xc,
            trace::InstRecord * traceData) const
    {
        Fault fault = NoFault;

        std::cout << "Performing %(op)s..." << std::endl;
        %(op_decl)s; // has no effect
        // stop
        // <PERCENT>(op_rd)s; // has no effect

        //uint64_t dst = xc->tcBase()->getReg(X86ISA::int_reg::Rdi);
		uint64_t dst = xc->getRegOperand(this, 0);
        DPRINTF(X86, "Value of Rdi: %d\n", dst);
        //uint64_t src1 = xc->tcBase()->getReg(X86ISA::int_reg::Rsi);
		uint64_t src1 = xc->getRegOperand(this, 1);
        DPRINTF(X86, "Value of Rsi: %d\n", src1);
        //uint64_t src2 = xc->tcBase()->getReg(X86ISA::int_reg::Rdx);
		uint64_t src2 = xc->getRegOperand(this, 2);
        DPRINTF(X86, "Value of Rdx: %d\n", src2);

        // store operands inside the Request
        // previously `<PERCENT>(rowop_data)s;`
        Request::RowOpPayload data =
            {Request::%(op)s, dst, src1, src2};
        DPRINTF(X86, "%s: %x <- %x %(op)s %x executing\n", mnemonic, dst,
            src1, src2);

        // NOTE: `byte_enable` is a mask indicating which
        // of the bytes in `data` are valid (for *partial writes*)
        // TODO: check `byteEnable`, sth seems to be wrong here
        std::vector<bool> byteEnable(sizeof(data));
        std::fill(byteEnable.begin(), byteEnable.end(), true);
        // perform actual memory operation
        // NOTE: addr=0 (as placeholder) since for Row-Op extract addr
        // from `data`
        fault = xc->writeMem((uint8_t *)&data, sizeof(data), 0,
                Request::UNCACHEABLE | Request::ROWOP, nullptr, byteEnable);

        return fault;
    }
}};


def template RowOpInitiateAcc {{
    Fault %(class_name)s::initiateAcc(ExecContext * xc,
            trace::InstRecord * traceData) const
    {
        Fault fault = NoFault;

        %(op_decl)s; // has no effect
        // <PERCENT>(op_rd)s; // has no effect

        //uint64_t dst = xc->tcBase()->getReg(X86ISA::int_reg::Rdi);
		uint64_t dst = xc->getRegOperand(this, 0);
        DPRINTF(X86, "Value of Rdi: %d\n", dst);
        //uint64_t src1 = xc->tcBase()->getReg(X86ISA::int_reg::Rsi);
		uint64_t src1 = xc->getRegOperand(this, 1);
        DPRINTF(X86, "Value of Rsi: %d\n", src1);
        //uint64_t src2 = xc->tcBase()->getReg(X86ISA::int_reg::Rdx);
		uint64_t src2 = xc->getRegOperand(this, 2);
        DPRINTF(X86, "Value of Rdx: %d\n", src2);

        Request::RowOpPayload data = {Request::%(op)s, dst, src1, src2};
        DPRINTF(X86, "%s: %x <- %x %(op)s %x initiated\n", mnemonic, dst,
            src1, src2);

        // TODO: check `byteEnable`, sth seems to be wrong here
        std::vector<bool> byteEnable(sizeof(data));
        std::fill(byteEnable.begin(), byteEnable.end(), true);
        // previously `<PERCENT>(rowop_write)s;`
        fault = xc->writeMem((uint8_t*)&data, sizeof(data), 0,
                Request::UNCACHEABLE | Request::ROWOP, nullptr, byteEnable);

        return fault;
    }
}};

def template RowOpCompleteAcc {{
    Fault %(class_name)s::completeAcc(PacketPtr pkt,
            ExecContext * xc, trace::InstRecord * traceData) const
    {
        Fault fault = NoFault;

        %(op_decl)s;
        %(op_rd)s;
        // DPRINTF(X86, "%s: %x <- %x %(op)s %x complete\n", mnemonic, dst,
        //     src1, src2);
        DPRINTF(X86, "%s: %x <- %x %(op)s %x complete\n", mnemonic, %(dst)s,
            %(src1)s, %(src2)s);

        return fault;
    }
}};

// Basic decode template, passing mnemonic in as string arg to constructor.
def template RowOpDecode {{
    return new %(class_name)s(machInst);
}};

    // iop = InstObjParams(name, Name,
    //     'X86ISA::RegOpT<X86ISA::FoldedDestOp,X86ISA::FoldedSrc1Op, \
    //     X86ISA::FoldedSrc2Op>',
    //      params, ['IsRowOp'])
def format RowOp() {{

    params = {
        'dst': 'Rdi',
        'src1': '0' if Name == 'ROWAP' else 'Rsi',
        'src2': '0' if Name in {'ROWNOT', 'ROWAP', 'ROWAAP'} else 'Rdx',
        'op': Name,
        'unused': 'Mem = 0'
    }

    iop = InstObjParams(name, Name, 'X86ISA::X86StaticInst', params)
    header_output = RowOpDeclare.subst(iop)
    exec_output = RowOpExecute.subst(iop) \
                + RowOpInitiateAcc.subst(iop) \
                + RowOpCompleteAcc.subst(iop)

    decoder_output = RowOpDecoder.subst(iop)
    decoder_output += RowOpConstructor.subst(iop)
    decode_block = RowOpDecode.subst(iop)
}};
